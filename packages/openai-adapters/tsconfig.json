{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmitOnError": false,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  // Tests are run by vitest (globals: true) and were never meant to ship in
  // dist/; they only compiled before because @types/jest was pulled in.
  "include": ["src/**/*"],
  "exclude": ["src/test/**", "src/**/*.test.ts", "src/**/*.vitest.ts"]
}

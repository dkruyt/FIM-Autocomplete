{
  "name": "fim-autocomplete",
  "author": "Dennis Kruyt",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dkruyt/FIM-Autocomplete.git"
  },
  "homepage": "https://github.com/dkruyt/FIM-Autocomplete#readme",
  "bugs": {
    "url": "https://github.com/dkruyt/FIM-Autocomplete/issues"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "license": "Apache-2.0",
  "displayName": "FIM Autocomplete",
  "description": "Standalone inline code autocomplete (fill-in-the-middle) for any LLM provider.",
  "publisher": "dkruyt",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.70.0",
    "node": ">=20.20.1"
  },
  "engine-strict": true,
  "categories": [
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "autocomplete",
    "fim",
    "fill-in-the-middle",
    "copilot",
    "ollama",
    "codestral"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "FIM Autocomplete",
      "properties": {
        "fim.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable inline autocomplete suggestions."
        },
        "fim.model": {
          "type": "object",
          "default": {},
          "markdownDescription": "The completion model. `provider` and `model` are required.",
          "properties": {
            "provider": {
              "type": "string",
              "description": "Provider id, e.g. \"ollama\", \"openai\", \"mistral\", \"deepseek\", \"vllm\", \"lmstudio\"."
            },
            "model": {
              "type": "string",
              "description": "Model name as the provider expects it, e.g. \"qwen2.5-coder:1.5b\"."
            },
            "apiBase": {
              "type": "string",
              "description": "Base URL of the API. Required for self-hosted providers."
            },
            "apiKey": {
              "type": "string",
              "description": "API key, if the provider needs one."
            },
            "template": {
              "type": "string",
              "description": "Override the autodetected FIM prompt template."
            },
            "contextLength": {
              "type": "number",
              "description": "Model context length in tokens."
            },
            "requestOptions": {
              "type": "object",
              "description": "Extra HTTP request options (headers, proxy, timeout, verifySsl)."
            },
            "completionOptions": {
              "type": "object",
              "description": "Sampling options (temperature, maxTokens, stop, ...)."
            }
          },
          "additionalProperties": false
        },
        "fim.debounceDelay": {
          "type": "number",
          "default": 350,
          "description": "Milliseconds to wait after a keystroke before requesting a completion."
        },
        "fim.modelTimeout": {
          "type": "number",
          "default": 150,
          "description": "Milliseconds to wait for the model before giving up."
        },
        "fim.maxPromptTokens": {
          "type": "number",
          "default": 1024,
          "description": "Token budget for the prompt (prefix + suffix + snippets)."
        },
        "fim.multilineCompletions": {
          "type": "string",
          "enum": [
            "always",
            "never",
            "auto"
          ],
          "default": "auto",
          "description": "Whether completions may span multiple lines."
        },
        "fim.useCache": {
          "type": "boolean",
          "default": true,
          "description": "Reuse recent completions for matching prefixes."
        },
        "fim.onlyMyCode": {
          "type": "boolean",
          "default": true,
          "description": "Only draw context snippets from your workspace, not dependencies."
        },
        "fim.useRecentlyEdited": {
          "type": "boolean",
          "default": true,
          "description": "Collect ranges you recently edited, for use as context."
        },
        "fim.useRecentlyOpened": {
          "type": "boolean",
          "default": true,
          "description": "Include recently opened files as context."
        },
        "fim.useImports": {
          "type": "boolean",
          "default": true,
          "description": "Include definitions of imported symbols as context."
        },
        "fim.transform": {
          "type": "boolean",
          "default": true,
          "description": "Post-process completions (trim, balance brackets, strip fences)."
        },
        "fim.disableInFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns where autocomplete is disabled."
        },
        "fim.pauseOnBattery": {
          "type": "boolean",
          "default": false,
          "description": "Pause autocomplete while on battery power."
        },
        "fim.experimental.includeClipboard": {
          "type": "boolean",
          "default": false,
          "description": "Include clipboard contents as context."
        },
        "fim.experimental.includeRecentlyVisitedRanges": {
          "type": "boolean",
          "default": true,
          "description": "Include recently visited ranges as context."
        },
        "fim.experimental.includeRecentlyEditedRanges": {
          "type": "boolean",
          "default": true,
          "description": "Include the collected recently-edited ranges in the prompt."
        },
        "fim.experimental.staticContextualization": {
          "type": "boolean",
          "default": false,
          "description": "Use tree-sitter/LSP static analysis to gather types and signatures."
        }
      }
    },
    "commands": [
      {
        "command": "fim.toggleEnabled",
        "category": "FIM",
        "title": "Toggle Autocomplete"
      },
      {
        "command": "fim.forceAutocomplete",
        "category": "FIM",
        "title": "Force Autocomplete"
      },
      {
        "command": "fim.openConfigMenu",
        "category": "FIM",
        "title": "Open Autocomplete Menu"
      },
      {
        "command": "fim.selectModel",
        "category": "FIM",
        "title": "Select Model"
      },
      {
        "command": "fim.logAutocompleteOutcome",
        "category": "FIM",
        "title": "Log Autocomplete Outcome"
      },
      {
        "command": "fim.startLocalOllama",
        "category": "FIM",
        "title": "Start Local Ollama"
      },
      {
        "command": "fim.startLocalLemonade",
        "category": "FIM",
        "title": "Start Local Lemonade"
      },
      {
        "command": "fim.installModel",
        "category": "FIM",
        "title": "Install Model"
      }
    ],
    "keybindings": [
      {
        "command": "fim.toggleEnabled",
        "mac": "cmd+k cmd+a",
        "key": "ctrl+k ctrl+a"
      },
      {
        "command": "fim.forceAutocomplete",
        "mac": "cmd+alt+\\",
        "key": "ctrl+alt+\\",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fim.logAutocompleteOutcome",
          "when": "false"
        },
        {
          "command": "fim.startLocalOllama",
          "when": "false"
        },
        {
          "command": "fim.startLocalLemonade",
          "when": "false"
        },
        {
          "command": "fim.installModel",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "esbuild-base": "node scripts/esbuild.js",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild-notify": "npm run esbuild-base -- --sourcemap --notify",
    "esbuild:visualize": "esbuild-visualizer --metadata ./build/meta.json --filename ./build/stats.html --open",
    "tsc": "tsc -p ./",
    "tsc:check": "tsc -p ./ --noEmit",
    "tsc-watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint . --ext ts --fix",
    "test": "vitest run",
    "vitest": "vitest run",
    "write-build-timestamp": "node scripts/write-build-timestamp.js",
    "prepackage": "node scripts/prepackage.js",
    "package": "node scripts/package.js",
    "package:pre-release": "node scripts/package.js --pre-release"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.13",
    "@types/node": "^20.19.9",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "1.70",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.0",
    "esbuild-visualizer": "^0.6.0",
    "eslint": "^8.28.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.3",
    "vitest": "^3.1.4",
    "ncp": "^2.0.0"
  },
  "dependencies": {
    "core": "file:../../core",
    "@fim/fetch": "file:../../packages/fetch",
    "uri-js": "^4.4.1",
    "uuid": "^9.0.1",
    "lru-cache": "^11.2.4",
    "lodash": "^4.17.21",
    "node-machine-id": "^1.1.12",
    "systeminformation": "^5.30.8"
  }
}

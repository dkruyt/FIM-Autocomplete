{
  "name": "fim-autocomplete",
  "author": "Dennis Kruyt",
  "version": "0.2.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/dkruyt/FIM-Autocomplete.git"
  },
  "homepage": "https://github.com/dkruyt/FIM-Autocomplete#readme",
  "bugs": {
    "url": "https://github.com/dkruyt/FIM-Autocomplete/issues"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "license": "Apache-2.0",
  "displayName": "FIM Autocomplete",
  "description": "Standalone inline code autocomplete (fill-in-the-middle) for any LLM provider.",
  "publisher": "dkruyt",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.70.0",
    "node": ">=20.20.1"
  },
  "engine-strict": true,
  "categories": [
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "autocomplete",
    "fim",
    "fill-in-the-middle",
    "copilot",
    "ollama",
    "codestral"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "FIM Autocomplete",
      "properties": {
        "fim.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable inline autocomplete suggestions."
        },
        "fim.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "lmstudio",
            "vllm",
            "llama.cpp",
            "lemonade",
            "mistral",
            "deepseek",
            "inception",
            "siliconflow",
            "moonshot",
            "openai",
            "anthropic",
            "askSage",
            "azure",
            "bedrock",
            "bedrockimport",
            "cerebras",
            "clawrouter",
            "cloudflare",
            "cohere",
            "cometapi",
            "deepinfra",
            "docker",
            "fireworks",
            "flowise",
            "function-network",
            "gemini",
            "groq",
            "huggingface-inference-api",
            "huggingface-tei",
            "huggingface-tgi",
            "kindo",
            "llamafile",
            "llamastack",
            "mimo",
            "minimax",
            "msty",
            "ncompass",
            "nebius",
            "nous",
            "novita",
            "nvidia",
            "openrouter",
            "ovhcloud",
            "relace",
            "replicate",
            "sagemaker",
            "sambanova",
            "scaleway",
            "tars",
            "tensorix",
            "text-gen-webui",
            "together",
            "venice",
            "vertexai",
            "voyage",
            "watsonx",
            "xAI",
            "zAI",
            "mock",
            "test"
          ],
          "enumDescriptions": [
            "Local models. Native FIM endpoint.",
            "LM Studio. Local models via an OpenAI-compatible server.",
            "Self-hosted vLLM server. Native FIM endpoint.",
            "Self-hosted llama.cpp server.",
            "Local Lemonade server with NPU/GPU acceleration.",
            "Mistral. Codestral is purpose-built for FIM. Native FIM endpoint.",
            "DeepSeek. deepseek-coder has a native FIM endpoint.",
            "Inception. Mercury Coder, a diffusion code model. Native FIM endpoint.",
            "SiliconFlow. Hosted open models. Native FIM endpoint.",
            "Moonshot. Native FIM endpoint.",
            "OpenAI, or any gateway speaking the OpenAI API - set apiBase. Native FIM endpoint.",
            "Anthropic Claude.",
            "Ask Sage.",
            "Azure OpenAI.",
            "AWS Bedrock.",
            "AWS Bedrock, imported custom model.",
            "Cerebras Inference.",
            "ClawRouter, a local router.",
            "Cloudflare Workers AI.",
            "Cohere.",
            "CometAPI.",
            "DeepInfra.",
            "Docker Model Runner, run locally.",
            "Fireworks AI.",
            "Flowise.",
            "Function Network.",
            "Google Gemini.",
            "Groq.",
            "Hugging Face Inference API.",
            "Hugging Face Text Embeddings Inference. Embeddings only.",
            "Hugging Face Text Generation Inference.",
            "Kindo.",
            "llamafile, run locally.",
            "Llama Stack.",
            "MiMo, by Xiaomi.",
            "MiniMax.",
            "Msty, run locally.",
            "nCompass.",
            "Nebius AI Studio.",
            "Nous Research.",
            "Novita AI.",
            "NVIDIA NIM.",
            "OpenRouter.",
            "OVHcloud AI Endpoints.",
            "Relace.",
            "Replicate.",
            "AWS SageMaker.",
            "SambaNova.",
            "Scaleway Generative APIs.",
            "Tetrate Agent Router Service.",
            "Tensorix.",
            "Text Generation WebUI.",
            "Together AI.",
            "Venice AI.",
            "Google Vertex AI.",
            "Voyage AI. Embeddings only.",
            "IBM watsonx.",
            "xAI Grok.",
            "Z.ai.",
            "Testing only.",
            "Testing only."
          ],
          "default": "",
          "order": 1,
          "markdownDescription": "Which LLM provider serves completions. Providers whose description says *Native FIM endpoint* have a real fill-in-the-middle API; the rest are prompted with the FIM template for the model and usually do worse.\n\nSet `#fim.model#` to go with it."
        },
        "fim.model": {
          "type": "string",
          "default": "",
          "order": 2,
          "markdownDescription": "Model name, exactly as `#fim.provider#` expects it - e.g. `qwen2.5-coder:1.5b`, `codestral-latest`, `deepseek-coder`.\n\nAutocomplete works best with a fill-in-the-middle code model. Run **FIM: Select Model** from the command palette to pick from the models your provider reports."
        },
        "fim.apiBase": {
          "type": "string",
          "default": "",
          "order": 3,
          "markdownDescription": "Base URL of the API. Required for self-hosted providers, e.g. `http://localhost:11434` for Ollama. Leave blank to use the provider's own default."
        },
        "fim.apiKey": {
          "type": "string",
          "default": "",
          "order": 4,
          "scope": "machine",
          "markdownDescription": "API key, if the provider needs one. Leave blank for local providers.\n\nStored in `settings.json` in plaintext and synced by Settings Sync. Machine-scoped, so it cannot be set from a checked-in `.vscode/settings.json`."
        },
        "fim.contextLength": {
          "type": "number",
          "order": 5,
          "markdownDescription": "Model context length in tokens. Leave unset to use the provider's default."
        },
        "fim.template": {
          "type": "string",
          "default": "",
          "order": 6,
          "markdownDescription": "Override the autodetected FIM prompt template with a Handlebars string using `{{{prefix}}}` and `{{{suffix}}}`. Leave blank to autodetect from the model name."
        },
        "fim.requestOptions": {
          "type": "object",
          "default": {},
          "order": 7,
          "markdownDescription": "Extra HTTP request options: `headers`, `proxy`, `timeout`, `verifySsl`. Edit in `settings.json`."
        },
        "fim.completionOptions": {
          "type": "object",
          "default": {},
          "order": 8,
          "markdownDescription": "Sampling options: `temperature`, `maxTokens`, `stop`, ... Edit in `settings.json`."
        },
        "fim.debounceDelay": {
          "type": "number",
          "default": 350,
          "description": "Milliseconds to wait after a keystroke before requesting a completion."
        },
        "fim.modelTimeout": {
          "type": "number",
          "default": 150,
          "description": "Milliseconds to wait for the model before giving up."
        },
        "fim.maxPromptTokens": {
          "type": "number",
          "default": 1024,
          "description": "Token budget for the prompt (prefix + suffix + snippets)."
        },
        "fim.multilineCompletions": {
          "type": "string",
          "enum": [
            "always",
            "never",
            "auto"
          ],
          "default": "auto",
          "description": "Whether completions may span multiple lines."
        },
        "fim.useCache": {
          "type": "boolean",
          "default": true,
          "description": "Reuse recent completions for matching prefixes."
        },
        "fim.onlyMyCode": {
          "type": "boolean",
          "default": true,
          "description": "Only draw context snippets from your workspace, not dependencies."
        },
        "fim.useRecentlyEdited": {
          "type": "boolean",
          "default": true,
          "description": "Collect ranges you recently edited, for use as context."
        },
        "fim.useRecentlyOpened": {
          "type": "boolean",
          "default": true,
          "description": "Include recently opened files as context."
        },
        "fim.useImports": {
          "type": "boolean",
          "default": true,
          "description": "Include definitions of imported symbols as context."
        },
        "fim.transform": {
          "type": "boolean",
          "default": true,
          "description": "Post-process completions (trim, balance brackets, strip fences)."
        },
        "fim.disableInFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns where autocomplete is disabled."
        },
        "fim.pauseOnBattery": {
          "type": "boolean",
          "default": false,
          "description": "Pause autocomplete while on battery power."
        },
        "fim.experimental.includeClipboard": {
          "type": "boolean",
          "default": false,
          "description": "Include clipboard contents as context."
        },
        "fim.experimental.includeRecentlyVisitedRanges": {
          "type": "boolean",
          "default": true,
          "description": "Include recently visited ranges as context."
        },
        "fim.experimental.includeRecentlyEditedRanges": {
          "type": "boolean",
          "default": true,
          "description": "Include the collected recently-edited ranges in the prompt."
        },
        "fim.experimental.staticContextualization": {
          "type": "boolean",
          "default": false,
          "description": "Use tree-sitter/LSP static analysis to gather types and signatures."
        }
      }
    },
    "commands": [
      {
        "command": "fim.toggleEnabled",
        "category": "FIM",
        "title": "Toggle Autocomplete"
      },
      {
        "command": "fim.forceAutocomplete",
        "category": "FIM",
        "title": "Force Autocomplete"
      },
      {
        "command": "fim.openConfigMenu",
        "category": "FIM",
        "title": "Open Autocomplete Menu"
      },
      {
        "command": "fim.openTutorial",
        "category": "FIM",
        "title": "Open Tutorial"
      },
      {
        "command": "fim.selectModel",
        "category": "FIM",
        "title": "Select Model"
      },
      {
        "command": "fim.logAutocompleteOutcome",
        "category": "FIM",
        "title": "Log Autocomplete Outcome"
      },
      {
        "command": "fim.startLocalOllama",
        "category": "FIM",
        "title": "Start Local Ollama"
      },
      {
        "command": "fim.startLocalLemonade",
        "category": "FIM",
        "title": "Start Local Lemonade"
      },
      {
        "command": "fim.installModel",
        "category": "FIM",
        "title": "Install Model"
      }
    ],
    "keybindings": [
      {
        "command": "fim.toggleEnabled",
        "mac": "cmd+k cmd+a",
        "key": "ctrl+k ctrl+a"
      },
      {
        "command": "fim.forceAutocomplete",
        "mac": "cmd+alt+\\",
        "key": "ctrl+alt+\\",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fim.logAutocompleteOutcome",
          "when": "false"
        },
        {
          "command": "fim.startLocalOllama",
          "when": "false"
        },
        {
          "command": "fim.startLocalLemonade",
          "when": "false"
        },
        {
          "command": "fim.installModel",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "esbuild-base": "node scripts/esbuild.js",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild-notify": "npm run esbuild-base -- --sourcemap --notify",
    "esbuild:visualize": "esbuild-visualizer --metadata ./build/meta.json --filename ./build/stats.html --open",
    "tsc": "tsc -p ./",
    "tsc:check": "npm run write-build-timestamp && tsc -p ./ --noEmit",
    "tsc-watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint . --ext ts --fix",
    "test": "vitest run",
    "vitest": "vitest run",
    "write-build-timestamp": "node scripts/write-build-timestamp.js",
    "prepackage": "node scripts/prepackage.js",
    "package": "node scripts/package.js",
    "package:pre-release": "node scripts/package.js --pre-release"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.13",
    "@types/node": "^20.19.9",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "1.70",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^8.28.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.6.3",
    "vitest": "^3.1.4",
    "ncp": "^2.0.0"
  },
  "dependencies": {
    "core": "file:../../core",
    "@fim/fetch": "file:../../packages/fetch",
    "uri-js": "^4.4.1",
    "uuid": "^9.0.1",
    "lru-cache": "^11.2.4",
    "lodash": "^4.17.21",
    "node-machine-id": "^1.1.12",
    "systeminformation": "^5.30.8"
  }
}

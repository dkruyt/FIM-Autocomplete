.vscode/**
.vscode-test/**
build/**
src/**
# Only the icon needs to ship. README images are served from GitHub by absolute
# URL, since the Marketplace does not resolve relative paths.
media/demo.gif
.gitignore
.npmrc
package-lock.json
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts
**/.env
**/env
node_modules/**
scripts
vitest.config.ts

# out/node_modules holds the runtime deps of the tokenizer workers, which are
# loaded from disk rather than bundled. They have to ship.
!out/node_modules/**

# ...but esbuild is a build-time dep that got hoisted in there.
out/node_modules/esbuild/**
out/node_modules/@esbuild/**
